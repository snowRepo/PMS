<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.auth.ForcedPinSetupController"
            prefWidth="600" prefHeight="500">

    <center>
        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 30 0 0 0;" BorderPane.alignment="TOP_CENTER">
            <VBox alignment="CENTER" spacing="8">
                <Label text="Set Security PIN"/>
                <Label text="Set a 6-digit PIN for security operations."/>
            </VBox>

            <VBox spacing="12" maxWidth="400">
                <VBox spacing="8" alignment="CENTER">
                    <Label text="ENTER PIN" />
                    <HBox fx:id="pinRow1" spacing="8" alignment="CENTER"/>
                </VBox>

                <VBox spacing="8" alignment="CENTER">
                    <Label text="CONFIRM PIN" />
                    <HBox fx:id="pinRow2" spacing="8" alignment="CENTER"/>
                </VBox>

                <Label fx:id="errorLabel" wrapText="true" managed="false" visible="false"/>

                <VBox spacing="8">
                    <Button text="Finish Setup" onAction="#handleSave" defaultButton="true" maxWidth="Infinity"/>
                </VBox>

                <Label text="This PIN will be used to authorize sensitive actions." wrapText="true" alignment="CENTER"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <Label text="© 2026 PMS - All Rights Reserved" maxWidth="Infinity" alignment="CENTER" style="-fx-padding: 24;"/>
    </bottom>
</BorderPane>
