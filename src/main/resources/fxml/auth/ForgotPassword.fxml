<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.auth.ForgotPasswordController"
            prefWidth="600" prefHeight="500">

    <center>
        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 30 0 0 0;" BorderPane.alignment="TOP_CENTER">
            <VBox alignment="CENTER" spacing="8">
                <Label text="PMS Setup"/>
                <Label text="Password Recovery"/>
            </VBox>

            <!-- Step container — only one visible at a time -->
            <VBox spacing="14" maxWidth="400">

                <!-- STEP 1: Username -->
                <VBox fx:id="step1" spacing="12">
                    <Label text="Enter your username to begin recovery." wrapText="true" alignment="CENTER"/>
                    <VBox spacing="4">
                        <Label text="Username:"/>
                        <TextField fx:id="usernameField" promptText="Your username"/>
                    </VBox>
                    <Label fx:id="step1Error" wrapText="true" managed="false" visible="false"/>
                    <Button text="Next →" onAction="#handleStep1" maxWidth="Infinity" defaultButton="true"/>
                </VBox>

                <!-- STEP 2: PIN -->
                <VBox fx:id="step2" spacing="12" managed="false" visible="false">
                    <Label fx:id="step2Hint" text="Enter your 6-digit security PIN." wrapText="true" alignment="CENTER"/>
                    <HBox fx:id="pinRow" spacing="8" alignment="CENTER"/>
                    <Label fx:id="step2Error" wrapText="true" managed="false" visible="false"/>
                    <Button text="Verify PIN →" onAction="#handleStep2" maxWidth="Infinity" defaultButton="true"/>
                </VBox>

                <!-- STEP 3: New password -->
                <VBox fx:id="step3" spacing="12" managed="false" visible="false">
                    <Label text="Enter your new password." wrapText="true" alignment="CENTER"/>
                    <VBox spacing="4">
                        <Label text="New Password:"/>
                        <PasswordField fx:id="newPassField" promptText="Min 8 characters"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Confirm Password:"/>
                        <PasswordField fx:id="confirmField" promptText="Re-enter password"/>
                    </VBox>
                    <Label fx:id="step3Error" wrapText="true" managed="false" visible="false"/>
                    <Button text="Reset Password" onAction="#handleStep3" maxWidth="Infinity" defaultButton="true"/>
                </VBox>

                <!-- Back to login -->
                <Button text="← Back to Login" onAction="#handleBack" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <Label text="© 2026 PMS - All Rights Reserved" maxWidth="Infinity" alignment="CENTER" style="-fx-padding: 24;"/>
    </bottom>
</BorderPane>
