<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.SettingsController"
            style="-fx-background-color: #f0f0f2;">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 30 20 30 20;" maxWidth="Infinity">
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="8">
                        <Label text="System Settings" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                        <Label text="Configure system-wide preferences, security, and cloud database." style="-fx-text-fill: #71717a;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="searchField" promptText="Search settings..." prefWidth="250" />
                </HBox>
                
                <!-- Localization -->
                <VBox fx:id="localizationPanel" spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 20;" >
                    <Label text="Localization" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                    <Separator/>
                    
                    <VBox spacing="4">
                        <Label text="Currency Symbol"/>
                        <ComboBox fx:id="currencyCombo" promptText="Select Currency" maxWidth="Infinity"/>
                    </VBox>
                    
                    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                        <Button text="Save Preferences" onAction="#handleSave"/>
                    </HBox>
                </VBox>

                <!-- Account -->
                <VBox fx:id="securityPanel" spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 20;" >
                    <Label text="Account" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                    <Separator/>
                    
                    <VBox spacing="10">
                        <VBox spacing="4">
                            <Label text="Full Name" style="-fx-text-fill: #71717a;"/>
                            <Label fx:id="accFullNameLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Username" style="-fx-text-fill: #71717a;"/>
                            <Label fx:id="accUsernameLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Role" style="-fx-text-fill: #71717a;"/>
                            <Label fx:id="accRoleLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </VBox>
                    </VBox>
                    
                    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                        <Button text="Change PIN" onAction="#handleOpenChangePin"/>
                        <Button text="Change Password" onAction="#handleOpenChangePassword"/>
                    </HBox>
                </VBox>

                <!-- Cloud Database -->
                <VBox fx:id="cloudDbPanel" spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 20;" >
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Cloud Database Connection" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="dbActiveStatusLabel" text="Disconnected" style="-fx-text-fill: #ef4444;"/>
                        <Button fx:id="connectToggleBtn" text="Connect" onAction="#handleConnectToggle" />
                    </HBox>
                    <Separator/>
                    
                    <VBox spacing="4">
                        <Label text="Database Type"/>
                        <ComboBox fx:id="dbTypeCombo" maxWidth="Infinity"/>
                    </VBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Host / Endpoint"/>
                            <TextField fx:id="dbHostField" promptText="e.g. database.com"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Port"/>
                            <TextField fx:id="dbPortField" prefWidth="80"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="4">
                        <Label text="Database Name"/>
                        <TextField fx:id="dbNameField" promptText="e.g. pms_db"/>
                    </VBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Username"/>
                            <TextField fx:id="dbUserField" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Password"/>
                            <PasswordField fx:id="dbPassField" />
                        </VBox>
                    </HBox>
                    <CheckBox fx:id="dbSslCheck" text="Require SSL / TLS Connection"/>
                    
                    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                        <Label fx:id="dbStatusLabel" text="Testing..." visible="false" managed="false"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Test Connection" onAction="#handleDbTest"/>
                        <Button fx:id="dbSaveBtn" text="Save Configuration" onAction="#handleDbSave" disable="true"/>
                    </HBox>
                </VBox>

                <!-- Danger Zone (Admin only) -->
                <VBox fx:id="dangerZonePanel" spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #f87171; -fx-border-radius: 8; -fx-padding: 20;">
                    <Label text="⚠  Danger Zone" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b91c1c;"/>
                    <Separator/>
                    <Label text="These actions are irreversible. Wiped data cannot be restored unless a backup exists on the other side."
                           style="-fx-text-fill: #71717a; -fx-font-size: 12px;" wrapText="true"/>
                    <VBox spacing="4">
                        <Label text="Data Reset" style="-fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                        <Label text="Wipe local data, cloud data, or both. Requires your password and PIN to proceed."
                               style="-fx-text-fill: #71717a; -fx-font-size: 12px;" wrapText="true"/>
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
                        <Button text="Reset Data..." onAction="#handleOpenResetData"/>
                    </HBox>
                </VBox>

                <!-- About Section -->
                <VBox fx:id="aboutPanel" spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 20;" >
                    <Label text="About PMS" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                    <Separator/>
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="4">
                            <Label text="Product Management System" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="Version: 1.0.0" style="-fx-text-fill: #71717a;"/>
                            <Label text="© 2026 PMS Inc. All rights reserved." style="-fx-text-fill: #71717a;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Check for Updates" onAction="#handleCheckUpdates"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
