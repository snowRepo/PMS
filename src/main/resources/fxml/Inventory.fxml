<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.InventoryController">

    <!-- Top Bar: Search and Add Button -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <VBox spacing="4">
                <Label text="Inventory" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                <Label text="Manage products, stock levels, and pricing." style="-fx-text-fill: #71717a;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Search Field -->
            <TextField fx:id="searchField" promptText="Search name, barcode..." prefWidth="250"/>
                       
            <!-- Add Item Button -->
            <Button text="+ Add Item" onAction="#handleAddItem"/>
        </HBox>
    </top>

    <!-- Center: The paginated TableView -->
    <center>
        <VBox spacing="0" style="-fx-padding: 0 20 0 20;">
            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8 8 0 0; -fx-border-radius: 8 8 0 0; -fx-border-color: #d4d4d8; -fx-border-width: 1 1 0 1;">
                <columns>
                    <TableColumn fx:id="colName" text="Product Name" prefWidth="200"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                    <TableColumn fx:id="colCost" text="Cost Price" prefWidth="100"/>
                    <TableColumn fx:id="colSelling" text="Selling Price" prefWidth="100"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="90"/>
                    <TableColumn fx:id="colExpiry" text="Expiry Date" prefWidth="110"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- Pagination Control directly underneath the table -->
            <StackPane style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d8; -fx-border-width: 0 1 1 1; -fx-background-radius: 0 0 8 8; -fx-border-radius: 0 0 8 8; -fx-padding: 8;">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5"/>
            </StackPane>
        </VBox>
    </center>

    <bottom>
        <Region prefHeight="20"/>
    </bottom>
</BorderPane>
