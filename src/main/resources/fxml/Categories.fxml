<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.CategoriesController">

    <!-- Top Bar: Search and Add Button -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <Label text="Categories" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Search Field -->
            <TextField fx:id="searchField" promptText="Search categories..." prefWidth="250"/>
                       
            <!-- Add Category Button -->
            <Button text="+ Add Category" onAction="#handleAddCategory"/>
        </HBox>
    </top>

    <!-- Center: The TableView -->
    <center>
        <VBox spacing="0" style="-fx-padding: 0 20 20 20;">
            <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8 8 0 0; -fx-border-radius: 8 8 0 0; -fx-border-color: #d4d4d8; -fx-border-width: 1 1 0 1;">
                <columns>
                    <TableColumn fx:id="colName" text="Category Name" prefWidth="200"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="350"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- Pagination Control directly underneath the table -->
            <StackPane style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d8; -fx-border-width: 0 1 1 1; -fx-background-radius: 0 0 8 8; -fx-border-radius: 0 0 8 8; -fx-padding: 8;">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5"/>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
