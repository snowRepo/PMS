<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.PurchaseHistoryController">

    <!-- Top Bar: Filters -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <VBox spacing="4">
                <Label text="Purchase History" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                <Label text="View and manage past supplier purchases." style="-fx-text-fill: #71717a;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <DatePicker fx:id="startDatePicker" promptText="Start Date" prefWidth="130"/>
            <DatePicker fx:id="endDatePicker" promptText="End Date" prefWidth="130"/>
            <ComboBox fx:id="statusFilter" promptText="Status" prefWidth="120"/>
            <TextField fx:id="historySearchField" promptText="Search Supplier or ID..." prefWidth="180"/>
        </HBox>
    </top>

    <!-- Center: The paginated TableView -->
    <center>
        <VBox spacing="0" style="-fx-padding: 0 20 0 20;">
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8 8 0 0; -fx-border-radius: 8 8 0 0; -fx-border-color: #d4d4d8; -fx-border-width: 1 1 0 1;">
                <columns>
                    <TableColumn fx:id="colHistDate" text="Date" prefWidth="150" minWidth="130"/>
                    <TableColumn fx:id="colHistId" text="Order ID" prefWidth="100" minWidth="80"/>
                    <TableColumn fx:id="colHistSupplier" text="Supplier" prefWidth="180" minWidth="150"/>
                    <TableColumn fx:id="colHistTotal" text="Total Amount" prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="colHistStatus" text="Status" prefWidth="80" minWidth="80"/>
                    <TableColumn fx:id="colHistActions" text="Actions" prefWidth="210" minWidth="210"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- Pagination Control directly underneath the table -->
            <StackPane style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d8; -fx-border-width: 0 1 1 1; -fx-background-radius: 0 0 8 8; -fx-border-radius: 0 0 8 8; -fx-padding: 8;">
                <Pagination fx:id="historyPagination" maxPageIndicatorCount="5"/>
            </StackPane>
        </VBox>
    </center>

    <bottom>
        <Region prefHeight="20"/>
    </bottom>
</BorderPane>
