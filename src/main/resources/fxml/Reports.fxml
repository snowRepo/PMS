<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.ReportsController"
            style="-fx-background-color: #f0f0f2;">

    <top>
        <VBox spacing="20" style="-fx-padding: 30 20 20 20; -fx-background-color: transparent;">
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox spacing="8">
                    <Label text="Sales Reports" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                    <Label text="Generate comprehensive reports for product sales and profits." style="-fx-text-fill: #71717a;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="exportCsvBtn" text="Export to CSV" onAction="#handleExportCSV" disable="true"/>
            </HBox>

            <!-- Filters & Summary -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 20;">
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="4">
                        <Label text="Start Date"/>
                        <DatePicker fx:id="startDatePicker" prefWidth="150"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="End Date"/>
                        <DatePicker fx:id="endDatePicker" prefWidth="150"/>
                    </VBox>
                    <VBox spacing="4" alignment="BOTTOM_LEFT">
                        <Label/>
                        <Button text="Generate Report" onAction="#handleGenerateReport"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Summary Cards -->
                <HBox spacing="20">
                    <VBox spacing="5" style="-fx-padding: 15; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;" HBox.hgrow="ALWAYS">
                        <Label text="Total Revenue" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                        <Label fx:id="totalRevenueLabel" text="GHS 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                    <VBox spacing="5" style="-fx-padding: 15; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;" HBox.hgrow="ALWAYS">
                        <Label text="Total Cost" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                        <Label fx:id="totalCostLabel" text="GHS 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                    <VBox spacing="5" style="-fx-padding: 15; -fx-background-color: #f0fdf4; -fx-border-color: #bbf7d0; -fx-border-radius: 6; -fx-background-radius: 6;" HBox.hgrow="ALWAYS">
                        <Label text="Overall Profit" style="-fx-text-fill: #166534; -fx-font-size: 13px;"/>
                        <Label fx:id="totalProfitLabel" text="GHS 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
                    </VBox>
                </HBox>

            </VBox>

        </VBox>
    </top>

    <center>
        <!-- TableView -->
        <VBox spacing="0" style="-fx-padding: 0 20 0 20;">
            <Label text="Product Sales Breakdown" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #18181b; -fx-padding: 0 0 10 0;"/>
            <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8 8 0 0; -fx-border-radius: 8 8 0 0; -fx-border-color: #d4d4d8; -fx-border-width: 1 1 0 1;">
                <columns>
                    <TableColumn fx:id="colProduct" text="Product Name" prefWidth="250">
                        <cellValueFactory><PropertyValueFactory property="productName"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colQty" text="Qty Sold" prefWidth="100">
                        <cellValueFactory><PropertyValueFactory property="qtySold"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRevenue" text="Revenue" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="totalRevenue"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colProfit" text="Profit" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="totalProfit"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            
            <!-- Pagination -->
            <StackPane style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d8; -fx-border-width: 0 1 1 1; -fx-background-radius: 0 0 8 8; -fx-border-radius: 0 0 8 8; -fx-padding: 8;">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5"/>
            </StackPane>
        </VBox>
    </center>

    <bottom>
        <Region prefHeight="20"/>
    </bottom>
</BorderPane>
