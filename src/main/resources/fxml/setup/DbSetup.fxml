<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.setup.DbSetupController"
            prefWidth="600" prefHeight="500">

    <center>
        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 30 0 0 0;" BorderPane.alignment="TOP_CENTER">
            <VBox alignment="CENTER" spacing="8">
                <Label text="PMS Setup"/>
                <Label text="Step 1 of 3 — Database Connection"/>
            </VBox>

            <VBox spacing="12" maxWidth="400">
                <VBox spacing="4">
                    <Label text="Database Type:"/>
                    <ComboBox fx:id="dbTypeCombo" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Host / Port:"/>
                    <HBox spacing="8">
                        <TextField fx:id="hostField" promptText="db.abc.supabase.co" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="portField" promptText="5432" prefWidth="80"/>
                    </HBox>
                </VBox>

                <VBox spacing="4">
                    <Label text="Database Name:"/>
                    <TextField fx:id="dbNameField" promptText="e.g. postgres"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Username:"/>
                    <TextField fx:id="userField" promptText="Username"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Password:"/>
                    <PasswordField fx:id="passField" promptText="Password"/>
                </VBox>

                <CheckBox fx:id="sslCheck" text="Require SSL (recommended for cloud)" selected="true"/>

                <Label fx:id="statusLabel" wrapText="true" managed="false" visible="false"/>

                <HBox spacing="10">
                    <Button text="Test Connection" onAction="#handleTest" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Skip (Local Only)" onAction="#handleSkip" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="continueBtn" text="Continue →" onAction="#handleContinue" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <Label text="© 2026 PMS - All Rights Reserved" maxWidth="Infinity" alignment="CENTER" style="-fx-padding: 24;"/>
    </bottom>
</BorderPane>
