<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pms.controller.ProductFormController"
      spacing="16"
      style="-fx-padding: 24;"
      prefWidth="600">

    <Label fx:id="titleLabel" text="Add New Item" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="150"/>
            <ColumnConstraints hgrow="NEVER" minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="150"/>
        </columnConstraints>

        <!-- Row 0 -->
        <Label text="Name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Brand / Generic Name" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="genericField" GridPane.rowIndex="0" GridPane.columnIndex="3" promptText="Auto-generated if empty"/>

        <!-- Row 1 -->
        <Label text="Barcode" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="barcodeField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Category" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="categoryField" promptText="Search/Type category..." GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <!-- Row 2 -->
        <Label text="Cost Price *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="costField" promptText="0.00" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Selling Price *" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="sellingField" promptText="0.00" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
        
        <!-- Row 3 -->
        <Label text="Stock Qty *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="stockField" promptText="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Reorder Level *" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <TextField fx:id="reorderField" promptText="10" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

        <!-- Row 4 -->
        <Label text="Expiry Date" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="expiryPicker" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444;" wrapText="true" visible="false" managed="false"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"/>
        <Button text="Save Item" onAction="#handleSave" style="-fx-background-color: #039ED3; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>
