<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.SalesController">

    <!-- Top Bar: Filters -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <Label text="Sales History" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <DatePicker fx:id="startDatePicker" promptText="Start Date" prefWidth="130"/>
            <DatePicker fx:id="endDatePicker" promptText="End Date" prefWidth="130"/>
            <ComboBox fx:id="userFilterCombo" promptText="All Users" prefWidth="150"/>
            <TextField fx:id="searchField" promptText="Search ID, Ref..." prefWidth="180"/>
            <Button text="Export CSV" onAction="#handleExport"/>
        </HBox>
    </top>

    <!-- Center: The paginated TableView -->
    <center>
        <VBox spacing="0" style="-fx-padding: 0 20 0 20;">
            <TableView fx:id="salesTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8 8 0 0; -fx-border-radius: 8 8 0 0; -fx-border-color: #d4d4d8; -fx-border-width: 1 1 0 1;">
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                    <TableColumn fx:id="colRef" text="Ref / ID" prefWidth="120"/>
                    <TableColumn fx:id="colCustomer" text="Customer" prefWidth="130"/>
                    <TableColumn fx:id="colCashier" text="Cashier" prefWidth="130"/>
                    <TableColumn fx:id="colMethod" text="Method" prefWidth="90"/>
                    <TableColumn fx:id="colTotal" text="Net Total" prefWidth="100"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- Pagination Control directly underneath the table -->
            <StackPane style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d8; -fx-border-width: 0 1 1 1; -fx-background-radius: 0 0 8 8; -fx-border-radius: 0 0 8 8; -fx-padding: 8;">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5"/>
            </StackPane>
        </VBox>
    </center>

    <bottom>
        <Region prefHeight="20"/>
    </bottom>
</BorderPane>
