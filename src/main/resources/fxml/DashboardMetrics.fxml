<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.DashboardMetricsController"
            style="-fx-background-color: #f0f0f2;">
    
    <top>
        <VBox style="-fx-padding: 30 20 20 20;" spacing="20">
            <VBox spacing="8">
                <Label text="Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                <Label text="Overview of system metrics." style="-fx-text-fill: #71717a;"/>
            </VBox>
            
            <HBox spacing="16">
                <!-- Total Sales Metric Card -->
                <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL SALES REVENUE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #71717a;"/>
                    <Label fx:id="salesLabel" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #039ED3;"/>
                </VBox>
                
                <!-- Today's Sales Metric Card -->
                <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                    <Label text="TODAY'S SALES" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #71717a;"/>
                    <Label fx:id="todaySalesLabel" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                </VBox>
                
                <!-- Products Metric Card -->
                <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                    <Label text="ACTIVE PRODUCTS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #71717a;"/>
                    <Label fx:id="productsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 0 20 20 20;" spacing="0">
            <Label text="Low Stock Products" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #18181b; -fx-padding: 0 0 10 0;"/>
            
            <TableView fx:id="lowStockTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8 8 0 0; -fx-border-radius: 8 8 0 0; -fx-border-color: #d4d4d8; -fx-border-width: 1 1 0 1;">
                <columns>
                    <TableColumn fx:id="colName" text="Product Name" prefWidth="300"/>
                    <TableColumn fx:id="colStock" text="Stock Left" prefWidth="150"/>
                    <TableColumn fx:id="colReorder" text="Reorder Level" prefWidth="150"/>
                </columns>
            </TableView>
            
            <!-- Pagination Control directly underneath the table -->
            <StackPane style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d8; -fx-border-width: 0 1 1 1; -fx-background-radius: 0 0 8 8; -fx-border-radius: 0 0 8 8; -fx-padding: 8;">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5"/>
            </StackPane>
        </VBox>
    </center>

</BorderPane>
