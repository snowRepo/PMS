<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.LoginController"
            prefWidth="600" prefHeight="500">

    <center>
        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 30 0 0 0;" BorderPane.alignment="TOP_CENTER">
            <VBox alignment="CENTER" spacing="8">
                <Label text="PMS"/>
                <Label text="Product Management System" style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
            </VBox>

            <VBox spacing="14" maxWidth="300">
                <VBox spacing="4">
                    <Label text="Username:"/>
                    <TextField fx:id="usernameField" promptText="Username"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Password:"/>
                    <PasswordField fx:id="passwordField" promptText="Password"/>
                </VBox>

                <Label fx:id="errorLabel" wrapText="true" managed="false" visible="false"/>

                <VBox spacing="8">
                    <Button fx:id="loginButton" text="Log In" onAction="#handleLogin" maxWidth="Infinity"/>
                    <Button text="Forgot Password?" onAction="#handleForgotPassword" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <Label text="© 2026 PMS - All Rights Reserved" maxWidth="Infinity" alignment="CENTER" style="-fx-padding: 24;"/>
    </bottom>
</BorderPane>
