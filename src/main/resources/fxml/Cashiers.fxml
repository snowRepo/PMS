<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.CashiersController">

    <!-- Top Bar: Search and Add Button -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <Label text="Users" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Search Field -->
            <TextField fx:id="searchField" promptText="Search username, name..." prefWidth="250"/>
            
            <!-- Status Filter -->
            <ComboBox fx:id="statusFilterCombo" prefWidth="120"/>
            
            <!-- Add User Button -->
            <Button text="+ Add User" onAction="#handleAddCashier"/>
        </HBox>
    </top>

    <!-- Center: The TableView -->
    <center>
        <VBox spacing="0" style="-fx-padding: 0 20 20 20;">
            <TableView fx:id="cashiersTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8 8 0 0; -fx-border-radius: 8 8 0 0; -fx-border-color: #d4d4d8; -fx-border-width: 1 1 0 1;">
                <columns>
                    <TableColumn fx:id="colName" text="Full Name" prefWidth="180" minWidth="180" maxWidth="180"/>
                    <TableColumn fx:id="colUsername" text="Username" prefWidth="150" minWidth="150" maxWidth="150"/>
                    <TableColumn fx:id="colRole" text="Role" prefWidth="120" minWidth="90"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120" minWidth="90"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="200" minWidth="200" maxWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- Pagination Control directly underneath the table -->
            <StackPane style="-fx-background-color: #ffffff; -fx-border-color: #d4d4d8; -fx-border-width: 0 1 1 1; -fx-background-radius: 0 0 8 8; -fx-border-radius: 0 0 8 8; -fx-padding: 8;">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5"/>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
