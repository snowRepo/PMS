<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.controller.PosController"
            style="-fx-background-color: #f0f0f2;">

    <top>
        <VBox style="-fx-padding: 20 20 10 20;" spacing="8">
            <Label text="Sales POS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #18181b;"/>
            <Label text="Point of Sale system for recording transactions." style="-fx-text-fill: #71717a;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 10 20 20 20;">
            
            <!-- LEFT: PRODUCT SEARCH -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 16;">
                <Label text="Search Products" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <HBox spacing="8">
                    <TextField fx:id="searchField" promptText="Scan barcode or type name..." HBox.hgrow="ALWAYS"/>
                </HBox>
                
                <!-- Product Grid (Cards) -->
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #d4d4d8; -fx-border-width: 1; -fx-border-radius: 4;">
                    <FlowPane fx:id="productsFlowPane" hgap="12" vgap="12" style="-fx-padding: 16; -fx-background-color: #f9fafb;"/>
                </ScrollPane>
            </VBox>

            <!-- RIGHT: CART & PAYMENT -->
            <!-- RIGHT: CART & PAYMENT -->
            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" prefWidth="450" minWidth="450">
                <VBox spacing="8" VBox.vgrow="ALWAYS" style="-fx-background: white; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d4d4d8; -fx-border-radius: 8; -fx-padding: 12;">
                    
                    <!-- Customer Selection -->
                    <VBox spacing="4">
                        <Label text="Customer (Optional)" style="-fx-font-weight: bold;"/>
                        <HBox spacing="8">
                            <TextField fx:id="customerSearchField" promptText="Search Customer..." HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="+" onAction="#handleNewCustomer"/>
                        </HBox>
                    </VBox>

                    <!-- Cart Table -->
                    <Label text="Cart Items" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="cartTable" style="-fx-border-color: #d4d4d8; -fx-border-width: 1;" minHeight="120" prefHeight="180">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8">
                                <Label text="Your cart is empty" style="-fx-font-size: 14px; -fx-text-fill: #71717a;"/>
                            </VBox>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colCartName" text="Item" prefWidth="140"/>
                            <TableColumn fx:id="colCartQty" text="Qty" prefWidth="50"/>
                            <TableColumn fx:id="colCartPrice" text="Price" prefWidth="80"/>
                            <TableColumn fx:id="colCartDisc" text="Disc" prefWidth="70"/>
                            <TableColumn fx:id="colCartSub" text="Total" prefWidth="80"/>
                        </columns>
                    </TableView>
                    
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Clear Cart" onAction="#handleClearCart"/>
                        <Button text="Remove Item" onAction="#handleRemoveItem"/>
                        <Button text="Edit Discount" onAction="#handleEditItemDiscount"/>
                    </HBox>

                    <!-- Checkout Details -->
                    <GridPane hgap="16" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <!-- Left column -->
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <VBox spacing="2">
                                <Label text="Payment Method:" style="-fx-font-weight: bold; -fx-text-fill: #3f3f46;"/>
                                <ComboBox fx:id="paymentMethodCombo" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label fx:id="refLabel" text="Transaction Ref:" style="-fx-font-weight: bold; -fx-text-fill: #3f3f46;" visible="false" managed="false"/>
                                <TextField fx:id="refField" promptText="Enter ID/Ref" visible="false" managed="false"/>
                            </VBox>
                        </VBox>
                        
                        <!-- Right column -->
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <VBox spacing="2">
                                <Label text="Cart Discount:" style="-fx-font-weight: bold; -fx-text-fill: #3f3f46;"/>
                                <TextField fx:id="cartDiscountField" text="0.00" promptText="e.g. 10 or 10%"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Tax:" style="-fx-font-weight: bold; -fx-text-fill: #3f3f46;"/>
                                <TextField fx:id="cartTaxField" text="0.00" promptText="e.g. 5 or 5%"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Amount Tendered:" style="-fx-font-weight: bold; -fx-text-fill: #3f3f46;"/>
                                <TextField fx:id="amountTenderedField" text="0.00"/>
                            </VBox>
                        </VBox>
                    </GridPane>

                    <!-- Flexible Space -->
                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- Standard Totals -->
                    <VBox spacing="2" style="-fx-padding: 4 0;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="NET TOTAL:" style="-fx-font-weight: bold; -fx-text-fill: #18181b;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="netTotalLabel" text="0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #039ED3;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="CHANGE:" style="-fx-font-weight: bold; -fx-text-fill: #18181b;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="changeLabel" text="0.00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                        </HBox>
                    </VBox>

                    <Button text="COMPLETE SALE &amp; PRINT" onAction="#handleCheckout" maxWidth="Infinity" style="-fx-background-color: #039ED3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10; -fx-background-radius: 4; -fx-cursor: hand;"/>

                </VBox>
            </ScrollPane>
        </HBox>
    </center>

</BorderPane>
