# PharmSys — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# .env is gitignored — never commit real credentials.

# ── Cloud PostgreSQL ───────────────────────────────────────────
# Format: jdbc:postgresql://<host>:<port>/<database>
# Examples:
#   Supabase:  jdbc:postgresql://db.<project>.supabase.co:5432/postgres
#   Neon:      jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
#   Railway:   jdbc:postgresql://<host>.railway.app:5432/<db>
#   Self-host: jdbc:postgresql://192.168.1.100:5432/pharmsys

DB_URL=jdbc:postgresql://YOUR_HOST:5432/pharmsys
DB_USER=pharmsys_user
DB_PASS=your_password_here
